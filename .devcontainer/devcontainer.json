{
  "name": "Groundtruth",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": { "label": "Groundtruth web UI", "onAutoForward": "openBrowser" },
    "3001": { "label": "Groundtruth API" }
  },
  "remoteEnv": { "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}" },
  "postCreateCommand": "sudo sysctl -w vm.max_map_count=262144 || true; npm --prefix api install && npm --prefix web install",
  "postStartCommand": "docker compose up -d || true",
  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss", "ms-azuretools.vscode-docker"]
    }
  }
}
